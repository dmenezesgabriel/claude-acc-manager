/* cam TUI — flat, low-chrome layout.
   Colors come from the registered "cam-*" themes (theme.py); this file only
   handles layout, spacing, and the few component states. */

Screen {
    background: $background;
}

#accounts-panel {
    height: auto;
    padding: 1 3;
    background: $background;
    border-bottom: solid $panel;
}

/* -- dashboard menu -------------------------------------------------------- */

#menu-title {
    height: 1;
    margin-top: 1;
    padding: 0 3;
    color: $secondary;
}

#menu {
    background: $background;
    padding: 1 2 0 1;
    scrollbar-size-vertical: 1;
}

#menu ListItem {
    background: transparent;
    padding: 0 1;
    border-left: thick $background;
}

#menu ListItem.-highlight,
#menu:focus ListItem.-highlight {
    color: $foreground;
    background: $surface;
    text-style: none;
    border-left: thick $primary;
}

MenuItem Static {
    color: $foreground;
}

MenuItem Static.menu-item-muted {
    color: $secondary;
}
